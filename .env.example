# پنل مدیریت فروشگاه دوستان
# اجرای خودکار لوکال: npm run setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=salt:hash
SESSION_SECRET=یک-رشته-طولانی-تصادفی
COOKIE_SECURE=false
# دیتابیس: لوکال خالی بگذارید (SQLite داخل پوشه data).
# روی Vercel آدرس Neon/Supabase را بگذارید (Vercel Storage → Neon خودش می‌سازد):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# AI Game Publisher — فقط سمت سرور (کلید هرگز در فرانت‌اند قرار نگیرد):
# APINEX_API_KEY=
# AINEX_BASE_URL=https://api.apinex.bond/v1
# AINEX_MODEL=glm-5.3-flash
# اختیاری: کلید RAWG برای منبع کاور RAWG (بدون آن، این منبع رد می‌شود):
# RAWG_API_KEY=
# اختیاری: مسیر داده‌ها (پیش‌فرض: پوشه data کنار پروژه)
# DOOSTAN_DATA_DIR=
